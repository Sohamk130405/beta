# Example development environment variables for GeoAttend backend
# Copy this file to backend/.env and update values for local development.

# Database connection (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://geoattend:geoattend@localhost:5432/geoattend

# Other example variables (do not use in production without securing secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_NAME=GeoAttend API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
ARCJET_KEY=
